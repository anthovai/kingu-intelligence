# kingu.anthovai.com — Kingu cloud (Artifacts, Skills sharing, desktop sign-in)
# /opt/kingu-cloud, API on 172.17.0.1:3470. DNS is on Vercel and points here
# directly, so Caddy gets the certificate itself (HTTP challenge).
kingu.anthovai.com {
	# Skill packages are up to 40 MiB.
	request_body {
		max_size 50MB
	}
	reverse_proxy 172.17.0.1:3470
}
