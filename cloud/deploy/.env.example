# Copy to deploy/.env on the server and fill in. Never commit the real file.
# openssl rand -base64 32
KINGU_POSTGRES_PASSWORD=
# openssl rand -base64 48
KINGU_API_GRANT_SECRET=
KINGU_API_PUBLIC_URL=https://kingu.anthovai.com
# Who may create a Kingu account: addresses and/or @domain entries, comma
# separated (e.g. me@example.com,@anthovai.com), or * for anyone.
KINGU_API_ALLOWED_EMAILS=
# Optional: token=userId pairs for scripts.
KINGU_API_STATIC_TOKENS=
